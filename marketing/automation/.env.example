# Copy to .env locally. This app binds only to 127.0.0.1:4317.
YARD_META_APP_ID=
YARD_META_APP_SECRET=
YARD_META_REDIRECT_URI=http://127.0.0.1:4317/oauth/meta/callback
# Current Meta Pages and Instagram documentation was verified at v26.0.
YARD_META_GRAPH_VERSION=v26.0
# Default: read-only event discovery and linked account identification.
# Add pages_manage_posts,instagram_content_publish only when enabling the separate approved publishing workflow.
# If the Page role came through Business Manager, Business Discovery may additionally require ads_read.
YARD_META_SCOPES=pages_show_list,pages_read_engagement,instagram_basic,instagram_manage_insights
# 64 hex chars (32 random bytes); keep old key in YARD_META_TOKEN_KEY_PREVIOUS during rotation.
YARD_META_TOKEN_KEY_ID=current
YARD_META_TOKEN_KEY=
YARD_META_TOKEN_KEY_PREVIOUS_ID=
YARD_META_TOKEN_KEY_PREVIOUS=
# Publishing stays off until manually enabled after integration review.
YARD_META_PUBLISH_ENABLED=false
# Public HTTPS immutable mirror; serve each approved asset at /{sha256}/{filename}; exact bytes are verified before publish.
YARD_META_MEDIA_BASE_URL=
# Optional PKCE. Enable only if the configured Meta Login flow officially supports it.
YARD_META_PKCE_ENABLED=false
# Text generation stays off. Set provider, model, API key, and a positive budget deliberately.
YARD_TEXT_PROVIDER=none
YARD_TEXT_MODEL=
YARD_TEXT_API_KEY=
YARD_TEXT_MONTHLY_BUDGET_USD=0
YARD_TEXT_INPUT_USD_PER_MILLION=0
YARD_TEXT_OUTPUT_USD_PER_MILLION=0
YARD_TEXT_MAX_OUTPUT_TOKENS=700

